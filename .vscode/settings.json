{
    "testMate.cpp.test.advancedExecutables": [
        {
            "name": "${filename}",
            "pattern": "{build,Build,BUILD,out,Out,OUT}/**/*{test,Test,TEST}*"
        },
        {
            "name": "${filename}",
            "pattern": "**/{build,Build,BUILD,out,Out,OUT}/**/*{test,Test,TEST}*"
        }
    ],
    "cmake.debugConfig": {
        "name": "OpenXcom Debug",
        "type": "cppvsdbg",
        "request": "launch",
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}/build/bin",
        "environment": [],
        "console": "integratedTerminal",
        "preLaunchTask": "Copy data"
    },
    "cmake.useCMakePresets": "never"
}
